# Copy to .env in the project root; .env is ignored by Git and loaded automatically.
# Process environment variables override this file. Keep real internal URLs out of this example.
UBS_BROKER_URL=
UBS_OPENAI_BASE_URL=
UBS_BROKER_VERSION=""
# false reproduces the supplied UBS script; true uses certificate verification.
UBS_SSL_VERIFY=true

# Personal OpenAI key, used only if UBS is absent or unavailable.
OPENAI_API_KEY=
